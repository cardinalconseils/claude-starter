# Project-generated sprint artifacts (CKS dogfooding output — not part of the plugin)
/SUMMARY.md
/VERIFICATION.md

# Local-only: repo explorer (development tool)
commands/explore.md
agents/repo-explorer.md
skills/repo-exploration/
.exploration/

# Local-only: attractor pipeline runner (separate package, not bundled with CKS)
/attractor/
pyproject.toml

.prd/logs/.current_session_id
.prd/HANDOFF.md
.prd/PRD-STATE.md
.prd/work-hierarchy.md
.prd/prd-config.json
.prd/session-*.md

# Local-only: dev commands (not shipped with plugin)
.claude/commands/
.worktrees/
notes.txt
.assess/
.attractor/
.concept/

# Eval results are per-dev; golden sets (product features and role briefs) are committed
/.evals/*
!/.evals/golden/
/.evals/results/

# Voice agent scaffolding (may contain config with sensitive values)
.voice/

# CCCS threat intel monitor (personal infra — not part of the plugin)
.agents/
scripts/cccs-session-check.sh

# finops cost feed and researcher social-signal cache (per-dev, regenerated)
.finops/costs.jsonl
.research/last30days/

# autoresearch loop artifacts (per-dev, per-run)
.autoresearch/*/results.tsv
.autoresearch/*/run.log
.autoresearch/*/raw/
.autoresearch/*/checkpoint.json
.autoresearch/*/STOP

# Role-eval fixtures ship project state (.prd/, .learnings/, .cks/ …) on purpose — the
# patterns above must not swallow them. Last match wins, so this stays the final rule.
!/.evals/golden/**
